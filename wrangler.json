{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathpath",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOM",
        "class_name": "MathClassroom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "mathpath-v1",
      "new_sqlite_classes": [
        "MathClassroom"
      ]
    }
  ],
  "account_id": "411e855db2e236ed186881845c318001",
  "vars": {
    "TEACHER_CODE_SHA256": "3ef5a92a54b38d6df7290d29d3851b9d4ec0fa869ce00249c55986955d8f28fa"
  }
}
