{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mathpath",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-05-15",
  "workers_dev": true,
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CLASSROOM",
        "class_name": "MathClassroom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "mathpath-v1",
      "new_sqlite_classes": [
        "MathClassroom"
      ]
    }
  ],
  "account_id": "411e855db2e236ed186881845c318001",
  "vars": {
    "HECTOR2026MATH99": "d79cc8f26cec5ade58f6123eed0faca3c12e7db9e4aee4d1eb8c8b52a2efe17f"
  }
}
